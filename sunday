## Requirements

* macOS or Linux
* `bash` 4+
* `curl`
* `jq`

On macOS:

```bash
#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="bdapi.conf"
COLLECTION_FILE="bd-postman-collection-public.json"

error() {
  echo "ERROR: $1" >&2
  exit 1
}

[[ -f "$CONFIG_FILE" ]] || error "Missing $CONFIG_FILE"
[[ -f "$COLLECTION_FILE" ]] || error "Missing $COLLECTION_FILE"

# shellcheck disable=SC1090
source "$CONFIG_FILE"

[[ -n "${BD_URL:-}" ]] || error "BD_URL not set in config"
[[ -n "${BD_API_TOKEN:-}" ]] || error "BD_API_TOKEN not set in config"

get_bearer_token() {
  local resp token code
  resp=$(curl -k -s -w "
%{http_code}" -X POST "$BD_URL/api/tokens/authenticate" \
    -H "Authorization: token $BD_API_TOKEN")

  token=$(echo "$resp" | head -n -1 | jq -r '.bearerToken // empty')
  code=$(echo "$resp" | tail -n 1)

  [[ "$code" == "200" ]] || error "Authentication failed (HTTP $code)"
  [[ -n "$token" ]] || error "Bearer token missing in response"

  echo "$token"
}

BEARER_TOKEN=$(get_bearer_token)

list_calls() {
  # Safely traverse Postman collection folders + requests
  jq -r '
    .. | objects | select(has("request") and has("name")) |
    "\(.request.method)    /\(.name)"
  ' "$COLLECTION_FILE" || error "Failed to parse Postman collection"
}

describe_call() {
  local path="$1"

  jq -r --arg path "$path" '
    .item[] | .item[] | select(.name == $path) |
    "Method: \(.request.method)
Path:   /api/\(.name)
Variables:" +
    (if (.request.url.variable | length) > 0 then
       "
" + (.request.url.variable[] | "  - " + .key)
     else
       " none"
     end)
  ' "$COLLECTION_FILE" || error "Endpoint not found: $path"
}

apply_vars() {
  local url="$1"; shift
  for pair in "$@"; do
    key="${pair%%=*}"; val="${pair#*=}"
    url="${url//\{$key\}/$val}"
  done
  echo "$url" | grep -q '{' && error "Missing required path variables"
  echo "$url"
}

call_api() {
  local path="$1"; shift
  local data_file="" vars=() limit="" offset=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --var) vars+=("$2"); shift 2 ;; 
      --data) data_file="$2"; shift 2 ;; 
      --limit) limit="$2"; shift 2 ;; 
      --offset) offset="$2"; shift 2 ;; 
      *) shift ;; 
    esac
  done

  req=$(jq -c --arg path "$path" '.item[] | .item[] | select(.name == $path)' "$COLLECTION_FILE")
  [[ -n "$req" ]] || error "Endpoint not found in collection"

  method=$(echo "$req" | jq -r '.request.method')
  url="$BD_URL/api/$path"
  url=$(apply_vars "$url" "${vars[@]}")

  query=""
  [[ -n "$limit" ]] && query="limit=$limit"
  [[ -n "$offset" ]] && query="${query:+$query&}offset=$offset"
  [[ -n "$query" ]] && url="$url?$query"

  if [[ -n "$data_file" ]]; then
    [[ -f "$data_file" ]] || error "Data file not found"
    resp=$(curl -k -s -w "
%{http_code}" -X "$method" "$url" \
      -H "Authorization: Bearer $BEARER_TOKEN" \
      -H "Content-Type: application/json" \
      --data "@$data_file")
  else
    resp=$(curl -k -s -w "
%{http_code}" -X "$method" "$url" \
      -H "Authorization: Bearer $BEARER_TOKEN")
  fi

  body=$(echo "$resp" | head -n -1)
  code=$(echo "$resp" | tail -n 1)

  case "$code" in
    200|201)
      echo "HTTP $code"
      echo "$body" | jq
      ;;
    401) error "Unauthorized (401): Invalid or expired token" ;; 
    403) error "Forbidden (403): Insufficient permissions" ;; 
    *)
      echo "HTTP $code"
      echo "$body" | jq -r '.' 2>/dev/null || echo "$body"
      exit 1
      ;;
  esac

  next=$(echo "$body" | jq -r '.meta.links.next.href // empty')
  [[ -n "$next" ]] && echo -e "
Next page available:
$next"
}

case "${1:-}" in
  list) list_calls ;; 
  describe) describe_call "$2" ;; 
  call) shift; call_api "$@" ;; 
  *) echo "Usage: bdapi {list|describe|call}" >&2; exit 1 ;; 
esac
```

