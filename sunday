## The bdapi Script

```bash
#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="bdapi.conf"
COLLECTION_FILE="bd-postman-collection-public.json"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "Missing $CONFIG_FILE" >&2
  exit 1
fi

source "$CONFIG_FILE"

if [[ -z "${BD_URL:-}" || -z "${BD_API_TOKEN:-}" ]]; then
  echo "BD_URL and BD_API_TOKEN must be set" >&2
  exit 1
fi

get_bearer_token() {
  curl -s -X POST "$BD_URL/api/tokens/authenticate" \
    -H "Authorization: token $BD_API_TOKEN" | jq -r '.bearerToken'
}

BEARER_TOKEN=$(get_bearer_token)

list_calls() {
  jq -r '.item[] | .item[] | "\(.request.method)    /\(.name)"' "$COLLECTION_FILE"
}

describe_call() {
  local path="$1"

  jq -r --arg path "$path" '
    .item[] | .item[] | select(.name == $path) |
    "Method: \(.request.method)\nPath:   /api/\(.name)\nVariables:\n" +
    ( [ .request.url.variable[]?.key ] | map("  - " + .) | join("\n") )
  ' "$COLLECTION_FILE"
}

call_api() {
  local path="$1"
  shift

  local data_file=""
  declare -A vars

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --var)
        key="${2%%=*}"
        val="${2#*=}"
        vars[$key]="$val"
        shift 2
        ;;
      --data)
        data_file="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  local req
  req=$(jq -c --arg path "$path" '.item[] | .item[] | select(.name == $path)' "$COLLECTION_FILE")

  local method
  method=$(echo "$req" | jq -r '.request.method')

  local url="$BD_URL/api/$path"

  for k in "${!vars[@]}"; do
    url="${url//\{$k\}/${vars[$k]}}"
  done

  if [[ -n "$data_file" ]]; then
    response=$(curl -k -s -w "\nHTTP %{http_code}" -X "$method" "$url" \
      -H "Authorization: Bearer $BEARER_TOKEN" \
      -H "Content-Type: application/json" \
      --data "@$data_file")
  else
    response=$(curl -k -s -w "\nHTTP %{http_code}" -X "$method" "$url" \
      -H "Authorization: Bearer $BEARER_TOKEN")
  fi

  echo "$response"
}

case "${1:-}" in
  list)
    list_calls
    ;;
  describe)
    describe_call "$2"
    ;;
  call)
    shift
    call_api "$@"
    ;;
  *)
    echo "Usage: bdapi {list|describe|call}" >&2
    exit 1
    ;;
esac
```

