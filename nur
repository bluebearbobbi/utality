run_command() {
  local NAME="$1"
  local QUERY="${2:-}"
  local RAW="${3:-false}"

  # get a valid bearer token
  TOKEN=$(get_bearer_token)

  # find the request object recursively
  local REQ_JSON
  REQ_JSON=$(jq -c --arg name "$NAME" '
    .. | objects | select(.name? == $name and .request?)
  ' "$COLLECTION_FILE")

  if [[ -z "$REQ_JSON" ]]; then
    echo "ERROR: Request not found or is a folder: $NAME"
    exit 1
  fi

  # method
  METHOD=$(echo "$REQ_JSON" | jq -r '.request.method')

  # url: prefer raw, substitute {{baseUrl}}, else build from path
  URL=$(echo "$REQ_JSON" | jq -r --arg base "$BASE_URL" '
    if .request.url.raw then
      (.request.url.raw | sub("\\{\\{baseUrl\\}\\}"; $base))
    elif .request.url.path then
      $base + "/" + (.request.url.path | join("/"))
    else
      empty
    end
  ')

  if [[ -z "$METHOD" || -z "$URL" ]]; then
    echo "ERROR: Could not build URL or method for $NAME"
    exit 1
  fi

  # debug output (remove if you want)
  echo "DEBUG: $METHOD $URL" >&2

  # run curl
  if [[ "$RAW" == "true" ]]; then
    curl -s -X "$METHOD" "$URL" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Accept: application/json"
  else
    curl -s -X "$METHOD" "$URL" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Accept: application/json" | jq
  fi
}
