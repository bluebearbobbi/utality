run_command() {
  local NAME="$1"
  local QUERY="${2:-}"
  local RAW="${3:-false}"

  TOKEN=$(get_bearer_token)

  METHOD=$(jq -r --arg name "$NAME" '
    .. | objects
    | select(.name? == $name and .request?)
    | .request.method
  ' "$COLLECTION_FILE")

  PATH=$(jq -r --arg name "$NAME" '
    .. | objects
    | select(.name? == $name and .request?)
    | if .request.url.raw then
        .request.url.raw
      else
        "/" + (.request.url.path | join("/"))
      end
  ' "$COLLECTION_FILE")

  if [[ -z "$METHOD" || -z "$PATH" || "$METHOD" == "null" || "$PATH" == "null" ]]; then
    echo "ERROR: Command not runnable (folder or invalid name): $NAME"
    exit 1
  fi

  URL="$BASE_URL$PATH$QUERY"

  # TEMP debug (remove later)
  echo "DEBUG: $METHOD $URL" >&2

  if [[ "$RAW" == "true" ]]; then
    curl -s -X "$METHOD" "$URL" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Accept: application/json"
  else
    curl -s -X "$METHOD" "$URL" \
      -H "Authorization: Bearer $TOKEN" \
      -H "Accept: application/json" | jq
  fi
}
