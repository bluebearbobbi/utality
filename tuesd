```bash
#!/bin/bash

# Black Duck SCA API Utility
# This script allows support engineers to test Black Duck API calls from the command line using the Postman collection.
# It uses only curl and jq.
# Config file: ~/.bd_config.json with {"base_url": "https://your-server.com", "api_token": "your_api_token"}
# Collection file: postman_collection.json (fetched automatically if not present)

set -e

# Check for jq and curl
command -v jq >/dev/null 2>&1 || { echo >&2 "jq is required but not installed. Aborting."; exit 1; }
command -v curl >/dev/null 2>&1 || { echo >&2 "curl is required but not installed. Aborting."; exit 1; }

CONFIG_FILE="$HOME/.bd_config.json"
COLLECTION_FILE="./postman_collection.json"

# Load config
if [ ! -f "$CONFIG_FILE" ]; then
  echo "Config file not found. Creating template."
  cat << EOF > "$CONFIG_FILE"
{
  "base_url": "https://your-blackduck-server.com",
  "api_token": "your_api_token_here"
}
EOF
  echo "Please edit $CONFIG_FILE with your Black Duck server URL and API token."
  exit 1
fi

BASE_URL=$(jq -r '.base_url' "$CONFIG_FILE")
API_TOKEN=$(jq -r '.api_token' "$CONFIG_FILE")

if [ -z "$BASE_URL" ] || [ -z "$API_TOKEN" ]; then
  echo "Invalid config: base_url or api_token missing."
  exit 1
fi

# Fetch collection if not present
if [ ! -f "$COLLECTION_FILE" ]; then
  echo "Fetching Postman collection from $BASE_URL/api-doc/postman-collection-public.json"
  curl -s -f "$BASE_URL/api-doc/postman-collection-public.json" -o "$COLLECTION_FILE" || {
    echo "Failed to fetch collection. Please download it manually from $BASE_URL/api-doc/postman-collection-public.json and save as $COLLECTION_FILE."
    exit 1
  }
fi

# Function to get fresh bearer token
get_bearer_token() {
  curl -s -X POST "$BASE_URL/api/tokens/authenticate" \
    -H "Authorization: token $API_TOKEN" \
    -H "Content-Type: application/json" | jq -r '.bearerToken'
}

# Function to replace Postman variables in a string (converts {{var}} to ${var} then uses envsubst)
replace_variables() {
  local input="$1"
  local temp="${input//\{\{/\$\{}"  # Replace {{ with ${
  temp="${temp//\}\}/\}}"         # Replace }} with }
  echo "$temp" | envsubst
}

# List available requests with paths
list_requests() {
  jq -r '
    def find_requests($path):
      if .request then $path else empty end,
      (.item? // empty)[] | find_requests($path + if $path == "" then "" else "/" end + .name);
    find_requests("")
  ' "$COLLECTION_FILE"
}

# Get request JSON by path (e.g., "Folder/Subfolder/Request Name")
get_request_json() {
  local req_path="$1"
  jq --arg p "$req_path" '
    def find_request($path; $current):
      if $path == "" then $current.request else
        ($path | split("/")[0]) as $first |
        ($path | split("/") | .[1:] | join("/")) as $rest |
        ($current.item // empty)[] | if .name == $first then find_request($rest; .) else empty end;
    find_request($p; .)
  ' "$COLLECTION_FILE"
}

# Execute a request by path
exec_request() {
  local req_path="$1"
  shift
  local request_json=$(get_request_json "$req_path")

  if [ "$request_json" = "null" ]; then
    echo "Request not found: $req_path"
    exit 1
  fi

  # Set built-in variables as environment vars
  export baseUrl="$BASE_URL"
  export apiToken="$API_TOKEN"

  # Check if bearerToken is needed and get fresh one
  if echo "$request_json" | grep -q '{{bearerToken}}'; then
    local bearer=$(get_bearer_token)
    if [ -z "$bearer" ]; then
      echo "Failed to obtain bearer token."
      exit 1
    fi
    export bearerToken="$bearer"
  fi

  # Set user-provided variables (key=value args)
  while [ $# -gt 0 ]; do
    if [[ $1 == *"="* ]]; then
      local key="${1%%=*}"
      local value="${1#*=}"
      export "$key"="$value"
    fi
    shift
  done

  # Extract request details
  local method=$(echo "$request_json" | jq -r '.method')
  local url=$(echo "$request_json" | jq -r '.url.raw')
  local body_mode=$(echo "$request_json" | jq -r '.body.mode // ""')
  local body_raw=$(echo "$request_json" | jq -r '.body.raw // ""')

  # Replace variables in URL
  local replaced_url=$(replace_variables "$url")

  # Build headers
  local headers=()
  echo "$request_json" | jq -c '.header[]?' | while read -r header; do
    local h_key=$(echo "$header" | jq -r '.key')
    local h_value=$(echo "$header" | jq -r '.value')
    local replaced_value=$(replace_variables "$h_value")
    headers+=("-H" "$h_key: $replaced_value")
  done

  # Handle body (assuming raw mode for simplicity; extend if needed)
  local body_opt=""
  if [ "$body_mode" = "raw" ] && [ -n "$body_raw" ]; then
    local replaced_body=$(replace_variables "$body_raw")
    body_opt="-d '$replaced_body'"
  elif [ -n "$body_mode" ]; then
    echo "Unsupported body mode: $body_mode"
    exit 1
  fi

  # Build and execute curl command
  local curl_cmd="curl -s -X $method \"${replaced_url}\" ${headers[*]} $body_opt"
  eval "$curl_cmd" | jq . || echo "Raw response (not JSON): $(eval "$curl_cmd")"
}

# Main command handler
case "$1" in
  list)
    list_requests
    ;;
  exec)
    shift
    exec_request "$@"
    ;;
  token)
    get_bearer_token
    ;;
  *)
    echo "Usage:"
    echo "  $0 list                  # List available request paths"
    echo "  $0 exec <path> [key=value ...]  # Execute request, provide variables as needed"
    echo "  $0 token                 # Get fresh bearer token"
    exit 1
    ;;
esac
```

